generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Permission {
  permissionId    String           @id @db.VarChar(8)
  name            String           @unique @db.VarChar(255)
  description     String?
  createdAt       DateTime         @default(now())
  createdBy       Int
  updatedAt       DateTime?
  updatedBy       Int?
  isDeleted       Boolean          @default(false)
  role_permission RolePermission[]
}

model Role {
  roleId          String           @id @db.VarChar(6)
  name            String           @unique @db.VarChar(255)
  description     String?
  createdAt       DateTime         @default(now())
  createdBy       Int              @default(1)
  updatedAt       DateTime?
  updatedBy       Int?
  isDeleted       Boolean          @default(false)
  users           User[]           @relation("UserRole")
  role_permission RolePermission[]
}

model RolePermission {
  roleId       String     @db.VarChar(6)
  permissionId String     @db.VarChar(8)
  createdAt    DateTime   @default(now())
  createdBy    Int        @default(1)
  updatedAt    DateTime?
  updatedBy    Int?
  isDeleted    Boolean    @default(false)
  permission   Permission @relation(fields: [permissionId], references: [permissionId])
  role         Role       @relation(fields: [roleId], references: [roleId])

  @@id([roleId, permissionId])
}

model User {
  userId       Int          @id @default(autoincrement())
  firstName    String       @db.VarChar(255)
  lastName     String       @db.VarChar(255)
  username     String       @unique @db.VarChar(255)
  password     String       @db.VarChar(255)
  roleId       String       @db.VarChar(6)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  createdBy    Int          @default(1)
  updatedAt    DateTime?
  updatedBy    Int?
  isDeleted    Boolean      @default(false)
  role         Role         @relation("UserRole", fields: [roleId], references: [roleId])
  books        Book[]       @relation("Author")
  bookReviewed BookReview[] @relation("BookReview")
}

model Book {
  bookId      Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  description String?
  author      Int
  genre       Int
  publishDate DateTime     @default(now())
  review      Decimal?     @db.Decimal
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  createdBy   Int          @default(1)
  updatedAt   DateTime?
  updatedBy   Int?
  isDeleted   Boolean      @default(false)
  authorInfo  User         @relation("Author", fields: [author], references: [userId])
  genreInfo   Genre        @relation("Genre", fields: [genre], references: [genreId])
  bookReview  BookReview[] @relation("Book")
}

model BookReview {
  reviewId  Int       @id @default(autoincrement())
  bookId    Int
  userId    Int
  rating    Decimal   @db.Decimal
  comments  String?
  createdAt DateTime  @default(now())
  createdBy Int
  updatedAt DateTime?
  updatedBy Int?
  isDeleted Boolean   @default(false)
  userInfo  User      @relation("BookReview", fields: [userId], references: [userId])
  bookInfo  Book      @relation("Book", fields: [bookId], references: [bookId])
}

model Genre {
  genreId   Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  createdBy Int       @default(1)
  updatedAt DateTime?
  updatedBy Int?
  isDeleted Boolean   @default(false)
  books     Book[]    @relation("Genre")
}
