{
  "name": "nodets",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/index.ts",
    "staging": "cross-env NODE_ENV=staging ts-node -r tsconfig-paths/register src/index.ts",
    "production": "cross-env NODE_ENV=production ts-node -r tsconfig-paths/register src/index.ts",
    "start:dev": "cross-env NODE_ENV=development nodemon -r tsconfig-paths/register src/index.ts",
    "start:staging": "cross-env NODE_ENV=staging nodemon -r tsconfig-paths/register src/index.ts",
    "start:production": "cross-env NODE_ENV=production nodemon -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:pull:dev": "dotenv -e .env.development -- prisma db pull --schema=prisma/schema.prisma",
    "prisma:generate:dev": "dotenv -e .env.development -- prisma generate --schema=prisma/schema.prisma",
    "prisma:push:dev": "dotenv -e .env.development -- prisma db push --schema=prisma/schema.prisma",
    "prisma:pull:staging": "dotenv -e .env.staging -- prisma db pull --schema=prisma/schema.prisma",
    "prisma:generate:staging": "dotenv -e .env.staging -- prisma generate --schema=prisma/schema.prisma",
    "prisma:push:staging": "dotenv -e .env.staging -- prisma db push --schema=prisma/schema.prisma",
    "prisma:pull:production": "dotenv -e .env.production -- prisma db pull --schema=prisma/schema.prisma",
    "prisma:generate:production": "dotenv -e .env.production -- prisma generate --schema=prisma/schema.prisma",
    "prisma:push:production": "dotenv -e .env.production -- prisma db push --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.8.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
